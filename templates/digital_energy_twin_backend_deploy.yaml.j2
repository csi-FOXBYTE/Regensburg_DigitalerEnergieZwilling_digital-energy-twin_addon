apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-energy-twin-backend
  labels:
    app: digital-energy-twin-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-energy-twin-backend
  template:
    metadata:
      labels:
        app: digital-energy-twin-backend
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: migrate
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
          command:
            - /bin/sh
            - -c
            - |
              node_modules/.bin/zenstack migrate deploy && exit 0

              node << 'EOF'
              const { Client } = require('pg');
              (async () => {
                const client = new Client({ connectionString: process.env.DATABASE_URL });
                await client.connect();
                const res = await client.query("SELECT tablename FROM pg_tables WHERE schemaname = 'public'");
                const tables = res.rows.map(r => r.tablename);
                if (tables.length === 1 && tables[0] === 'postgres_log') {
                  await client.query(`CREATE TABLE _prisma_migrations (
                    id CHARACTER VARYING(36) NOT NULL,
                    checksum CHARACTER VARYING(64) NOT NULL,
                    finished_at TIMESTAMP WITH TIME ZONE,
                    migration_name CHARACTER VARYING(255) NOT NULL,
                    logs TEXT,
                    rolled_back_at TIMESTAMP WITH TIME ZONE,
                    started_at TIMESTAMP WITH TIME ZONE NOT NULL DEFAULT now(),
                    applied_steps_count INTEGER NOT NULL DEFAULT 0,
                    CONSTRAINT _prisma_migrations_pkey PRIMARY KEY (id)
                  )`);
                  console.log('Only postgres_log present — created _prisma_migrations, retrying.');
                  await client.end();
                  process.exit(0);
                } else {
                  console.error('Unexpected tables in public schema:', tables.join(', '));
                  await client.end();
                  process.exit(1);
                }
              })().catch(e => { console.error(e.message); process.exit(1); });
              EOF

              [ $? -eq 0 ] && node_modules/.bin/zenstack migrate deploy
          env:
            - name: DATABASE_URL
              value: "{{ digital_energy_twin_database_url }}"
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      containers:
        - name: backend
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
              add:
                - NET_BIND_SERVICE
          env:
            - name: DATABASE_URL
              value: "{{ digital_energy_twin_database_url }}"
            - name: PORT
              value: "{{ digital_energy_twin_backend_port | string }}"
            - name: KEYCLOAK_JWKS_URI
              value: "{{ inv_access.platform.hostname }}/realms/{{ inv_access.tenant.realm_name }}/protocol/openid-connect/certs"
            - name: TILES_URL
              value: "{{ digital_energy_twin_tiles_url }}"
            - name: TERRAIN_URL
              value: "{{ digital_energy_twin_terrain_url }}"
            - name: ADDRESS_DATABASE_URL
              value: "{{ digital_energy_twin_address_database_url }}"
            - name: APP_BASE_URL
              value: "https://{{ digital_energy_twin_backend_direct_host }}"
            - name: PUBLIC_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_public_direct_host }}"
            - name: ADMIN_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_admin_direct_host }}"
          ports:
            - containerPort: {{ digital_energy_twin_backend_port | int }}
          startupProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            failureThreshold: 30
            periodSeconds: 15
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 5
            failureThreshold: 3
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 30
            failureThreshold: 5
            timeoutSeconds: 10
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
