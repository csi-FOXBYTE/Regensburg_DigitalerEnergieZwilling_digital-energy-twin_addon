apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-energy-twin-backend
  labels:
    app: digital-energy-twin-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-energy-twin-backend
  template:
    metadata:
      labels:
        app: digital-energy-twin-backend
    spec:
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: migrate
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          command:
            - /bin/sh
            - -c
            # Everything the migration writes goes to its own /tmp volume:
            # zenstack writes ~schema.prisma next to the schema, so it migrates
            # a copy of the schema and its migrations. The image ships no Prisma
            # schema engine and Prisma would download it into node_modules, so
            # it is fetched into /tmp unless the image provides one.
            - |
              set -e
              cp -R src/zenstack /tmp/zenstack
              PRISMA_SCHEMA_ENGINE_BINARY="$(node -e '
              const fs = require("fs");
              const path = require("path");
              const { createRequire } = require("module");
              const cli = createRequire(fs.realpathSync("node_modules/@zenstackhq/cli/package.json"));
              const engines = createRequire(cli.resolve("prisma/build/index.js")).resolve("@prisma/engines");
              const { enginesVersion, getEnginesPath } = require(engines);
              const bundled = fs.readdirSync(getEnginesPath()).find((name) => name.startsWith("schema-engine-"));
              if (bundled) {
                console.log(path.join(getEnginesPath(), bundled));
              } else {
                fs.mkdirSync("/tmp/prisma-engines", { recursive: true });
                createRequire(engines)("@prisma/fetch-engine")
                  .download({ binaries: { "schema-engine": "/tmp/prisma-engines" }, version: enginesVersion, showProgress: false, failSilent: false })
                  .then((paths) => console.log(Object.values(paths["schema-engine"])[0]));
              }
              ')"
              export PRISMA_SCHEMA_ENGINE_BINARY
              exec node_modules/.bin/zenstack migrate deploy --schema /tmp/zenstack/schema.zmodel
          env:
            # Prisma's engine cache and CLI state live under $HOME.
            - name: HOME
              value: /tmp
            # No version check against checkpoint.prisma.io.
            - name: CHECKPOINT_DISABLE
              value: "1"
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_database_secret_name }}"
                  key: DATABASE_URL
            # zenstack/prisma loads the client and query engine; cap the heap
            # below the limit (~66%) so it GCs before the cgroup OOM-kills it.
            - name: NODE_OPTIONS
              value: "{{ digital_energy_twin_migrate_node_options | default('--max-old-space-size=' ~ (((digital_energy_twin_migrate_memory_limit_mb | default(512)) * 0.66) | int)) }}"
          resources:
            requests:
              cpu: "{{ digital_energy_twin_migrate_cpu_request | default('50m') }}"
              memory: "{{ digital_energy_twin_migrate_memory_request | default('128Mi') }}"
            limits:
              memory: "{{ digital_energy_twin_migrate_memory_limit_mb | default(512) }}Mi"
          volumeMounts:
            - name: migrate-tmp
              mountPath: /tmp
      containers:
        - name: backend
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_database_secret_name }}"
                  key: DATABASE_URL
            - name: PORT
              value: "{{ digital_energy_twin_backend_port | string }}"
            # Cap V8's heap below the memory limit so Node garbage-collects
            # before the cgroup OOM-kills it (heap ~66% of the limit). Derived
            # from the limit so overriding one value keeps both in lockstep.
            - name: NODE_OPTIONS
              value: "{{ digital_energy_twin_backend_node_options | default('--max-old-space-size=' ~ (((digital_energy_twin_backend_memory_limit_mb | default(768)) * 0.66) | int)) }}"
            # Days after submission until the deletion link stops serving the
            # data download. Status check and deletion stay possible.
            - name: SUBMISSION_DELETION_TOKEN_TTL_DAYS
              value: "{{ digital_energy_twin_submission_deletion_token_ttl_days | string }}"
            # Signs the Altcha challenges of the public writes; generated once
            # by the tasks. The backend refuses to start without it.
            - name: ALTCHA_HMAC_KEY
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_altcha_secret_name }}"
                  key: ALTCHA_HMAC_KEY
{% if digital_energy_twin_feedback_mail_to | default("") %}
            - name: SMTP_URL
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_smtp_secret_name }}"
                  key: SMTP_URL
            # The backend reads the sender from MAIL_FROM (apps/backend .env.example).
            - name: MAIL_FROM
              value: "{{ inv_email.email_from }}"
            - name: FEEDBACK_MAIL_TO
              value: "{{ digital_energy_twin_feedback_mail_to }}"
{% endif %}
{% if digital_energy_twin_matomo_tracking | default(false) | bool %}
            # Without both variables the backend offers no web analytics.
            - name: MATOMO_URL
              value: "https://{{ digital_energy_twin_matomo_host }}/matomo.php"
            - name: MATOMO_SITE_ID
              value: "{{ digital_energy_twin_matomo_site_id }}"
{% endif %}
            - name: KEYCLOAK_JWKS_URI
              value: "{{ inv_access.platform.hostname }}/realms/{{ inv_access.tenant.realm_name }}/protocol/openid-connect/certs"
            - name: KEYCLOAK_ISSUER
              value: "{{ inv_access.platform.hostname }}/realms/{{ inv_access.tenant.realm_name }}"
            # The backend requires aud to contain the DEZ client; an audience
            # mapper on the OIDC client (see tasks) puts it into the token.
            - name: AUTH_EXPECTED_AUDIENCE
              value: "{{ digital_energy_twin_oidc_client_id }}"
            - name: TILES_URL
              value: "{{ digital_energy_twin_tiles_url }}"
            - name: TERRAIN_URL
              value: "{{ digital_energy_twin_terrain_url }}"
            - name: ADDRESS_DATABASE_URL
              value: "{{ digital_energy_twin_address_database_url }}"
            - name: APP_BASE_URL
              value: "https://{{ digital_energy_twin_backend_direct_host }}"
            - name: PUBLIC_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_public_direct_host }}"
            - name: ADMIN_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_admin_direct_host }}"
            # Extra CORS origins beyond public/admin host; the backend adds
            # these to its allowlist (empty string = none).
            - name: AUTH_CORS_ADDITIONAL_ORIGINS
              value: "{{ digital_energy_twin_backend_cors_additional_origins }}"
          resources:
            requests:
              cpu: "{{ digital_energy_twin_backend_cpu_request | default('50m') }}"
              memory: "{{ digital_energy_twin_backend_memory_request | default('256Mi') }}"
            limits:
              memory: "{{ digital_energy_twin_backend_memory_limit_mb | default(768) }}Mi"
          ports:
            - containerPort: {{ digital_energy_twin_backend_port | int }}
          startupProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            failureThreshold: 30
            periodSeconds: 15
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 5
            failureThreshold: 3
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 30
            failureThreshold: 5
            timeoutSeconds: 10
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
        # Schema copy, Prisma engine cache and schema engine (~40 MB); kept
        # apart from the backend's /tmp so the engine does not outlive the
        # migration.
        - name: migrate-tmp
          emptyDir:
            sizeLimit: 128Mi
