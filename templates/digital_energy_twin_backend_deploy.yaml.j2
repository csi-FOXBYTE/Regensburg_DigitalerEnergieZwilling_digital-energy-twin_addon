apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-energy-twin-backend
  labels:
    app: digital-energy-twin-backend
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-energy-twin-backend
  template:
    metadata:
      labels:
        app: digital-energy-twin-backend
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      initContainers:
        - name: migrate
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: false
            capabilities:
              drop:
                - ALL
          command:
            - /bin/sh
            - -c
            - exec node_modules/.bin/zenstack migrate deploy
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_database_secret_name }}"
                  key: DATABASE_URL
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      containers:
        - name: backend
          image: "{{ digital_energy_twin_backend_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 1000
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          env:
            - name: DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: "{{ digital_energy_twin_database_secret_name }}"
                  key: DATABASE_URL
            - name: PORT
              value: "{{ digital_energy_twin_backend_port | string }}"
            - name: KEYCLOAK_JWKS_URI
              value: "{{ inv_access.platform.hostname }}/realms/{{ inv_access.tenant.realm_name }}/protocol/openid-connect/certs"
            - name: TILES_URL
              value: "{{ digital_energy_twin_tiles_url }}"
            - name: TERRAIN_URL
              value: "{{ digital_energy_twin_terrain_url }}"
            - name: ADDRESS_DATABASE_URL
              value: "{{ digital_energy_twin_address_database_url }}"
            - name: APP_BASE_URL
              value: "https://{{ digital_energy_twin_backend_direct_host }}"
            - name: PUBLIC_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_public_direct_host }}"
            - name: ADMIN_CLIENT_BASE_URL
              value: "https://{{ digital_energy_twin_admin_direct_host }}"
          ports:
            - containerPort: {{ digital_energy_twin_backend_port | int }}
          startupProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            failureThreshold: 30
            periodSeconds: 15
            timeoutSeconds: 5
          readinessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 5
            failureThreshold: 3
            timeoutSeconds: 5
          livenessProbe:
            httpGet:
              path: /health
              port: {{ digital_energy_twin_backend_port | int }}
            periodSeconds: 30
            failureThreshold: 5
            timeoutSeconds: 10
          volumeMounts:
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: tmp
          emptyDir: {}
