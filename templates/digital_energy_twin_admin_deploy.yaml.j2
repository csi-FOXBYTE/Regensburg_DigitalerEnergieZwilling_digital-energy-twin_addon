apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-energy-twin-admin
  labels:
    app: digital-energy-twin-admin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-energy-twin-admin
  template:
    metadata:
      labels:
        app: digital-energy-twin-admin
    spec:
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: admin
          image: "{{ digital_energy_twin_admin_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
              add:
                - NET_BIND_SERVICE
          ports:
            - containerPort: {{ digital_energy_twin_admin_port | int }}
