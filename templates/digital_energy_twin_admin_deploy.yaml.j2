apiVersion: apps/v1
kind: Deployment
metadata:
  name: digital-energy-twin-admin
  labels:
    app: digital-energy-twin-admin
spec:
  replicas: 1
  selector:
    matchLabels:
      app: digital-energy-twin-admin
  template:
    metadata:
      labels:
        app: digital-energy-twin-admin
    spec:
      securityContext:
        runAsNonRoot: true
        runAsUser: 101
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: admin
          image: "{{ digital_energy_twin_admin_image }}"
          imagePullPolicy: Always
          securityContext:
            runAsNonRoot: true
            runAsUser: 101
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
              add:
                - NET_BIND_SERVICE
          ports:
            - containerPort: {{ digital_energy_twin_admin_port | int }}
          volumeMounts:
            - name: nginx-cache
              mountPath: /var/cache/nginx
            - name: nginx-run
              mountPath: /var/run
            - name: tmp
              mountPath: /tmp
      volumes:
        - name: nginx-cache
          emptyDir: {}
        - name: nginx-run
          emptyDir: {}
        - name: tmp
          emptyDir: {}
