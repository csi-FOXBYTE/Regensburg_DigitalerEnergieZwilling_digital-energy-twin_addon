apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "{{ digital_energy_twin_ingress_host.name }}"
  namespace: "{{ digital_energy_twin_apisix_namespace }}"
  annotations:
    cert-manager.io/cluster-issuer: "{{ inv_k8s.cert_manager.issuer_name }}"
    kubernetes.io/tls-acme: "true"
    nginx.ingress.kubernetes.io/ssl-redirect: "{{ (not (inv_k8s.ingress.http | default(false) | bool)) | string | lower }}"
spec:
  ingressClassName: "{{ inv_k8s.ingress_class }}"
  tls:
    - hosts:
        - "{{ digital_energy_twin_ingress_host.hostname }}"
      secretName: "{{ digital_energy_twin_ingress_host.hostname }}-tls"
  rules:
    - host: "{{ digital_energy_twin_ingress_host.hostname }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: "{{ digital_energy_twin_apisix_service_name }}"
                port:
                  number: 80
